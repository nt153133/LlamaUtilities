<Project>
    <!-- RB gives each compiled Quest Behaviors assembly a new name. Resolve the newest one
         from the configured installation, or accept an explicit assembly for reproducible builds. -->
    <PropertyGroup>
        <RebornBuddyDirectory Condition="'$(RebornBuddyDirectory)' == ''">$(MSBuildProjectDirectory)\..\..</RebornBuddyDirectory>
        <RebornBuddyAssembly Condition="'$(RebornBuddyAssembly)' == ''">$(RebornBuddyDirectory)\RebornBuddy.dll</RebornBuddyAssembly>
    </PropertyGroup>

    <UsingTask TaskName="FindLlamaUtilitiesQuestBehaviors" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <InstallationDirectory ParameterType="System.String" Required="true" />
            <AssemblyPath ParameterType="System.String" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                // Read filenames only: loading RB code inside MSBuild could execute game-dependent
                // initializers. A stale/incompatible assembly must fail compilation, not be hidden.
                var directory = Path.Combine(InstallationDirectory, "CompiledAssemblies");
                if (Directory.Exists(directory))
                {
                    AssemblyPath = new DirectoryInfo(directory)
                        .GetFiles("Quest Behaviors_*.dll")
                        .OrderByDescending(file => file.LastWriteTimeUtc)
                        .ThenBy(file => file.Name, System.StringComparer.Ordinal)
                        .Select(file => file.FullName)
                        .FirstOrDefault();
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="ResolveLlamaUtilitiesQuestBehaviors" BeforeTargets="ResolveAssemblyReferences">
        <FindLlamaUtilitiesQuestBehaviors InstallationDirectory="$(RebornBuddyDirectory)" Condition="'$(QuestBehaviorsAssembly)' == ''">
            <Output TaskParameter="AssemblyPath" PropertyName="QuestBehaviorsAssembly" />
        </FindLlamaUtilitiesQuestBehaviors>
        <Error Condition="'$(QuestBehaviorsAssembly)' == '' Or !Exists('$(QuestBehaviorsAssembly)')" Text="Quest Behaviors assembly not found. Start RebornBuddy once to compile its Quest Behaviors, then build with -p:RebornBuddyDirectory=&quot;path to RB&quot; or -p:QuestBehaviorsAssembly=&quot;path to Quest Behaviors DLL&quot;." />
        <Error Condition="!Exists('$(RebornBuddyAssembly)')" Text="Matching RebornBuddy.dll not found. Set RebornBuddyDirectory to the installation that compiled Quest Behaviors, or set RebornBuddyAssembly explicitly." />
        <ItemGroup>
            <!-- Quest Behaviors references its host's exact RB version. Keep the package's
                 companion references, but replace its RB contract with that same local host. -->
            <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'RebornBuddy'" />
            <Reference Include="RebornBuddy">
                <HintPath>$(RebornBuddyAssembly)</HintPath>
                <Private>false</Private>
            </Reference>
            <!-- This assembly also contains LlamaLibrary. Keep it out of the global namespace
                 and deployment output so it cannot conflict with the pinned NuGet dependency. -->
            <Reference Include="LlamaUtilitiesQuestBehaviors">
                <HintPath>$(QuestBehaviorsAssembly)</HintPath>
                <Aliases>RBQuestBehaviors</Aliases>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <Target Name="GenerateLlamaUtilitiesQuestBehaviorAliases" BeforeTargets="CoreCompile" DependsOnTargets="ResolveLlamaUtilitiesQuestBehaviors">
        <PropertyGroup>
            <_QuestBehaviorAliasesFile>$(IntermediateOutputPath)LlamaUtilities.QuestBehaviorAliases.g.cs</_QuestBehaviorAliasesFile>
        </PropertyGroup>
        <ItemGroup>
            <!-- Generate under obj, which RB's source compiler skips. Runtime sources continue
                 resolving these names from RB normally, without build-only preprocessor branches. -->
            <_QuestBehaviorAliasLine Include="// Build-only aliases to RB's existing base types, generated by Build/QuestBehaviors.targets." />
            <_QuestBehaviorAliasLine Include="extern alias RBQuestBehaviors%3B" />
            <_QuestBehaviorAliasLine Include="global using SimpleDutyTag = RBQuestBehaviors::ff14bot.NeoProfiles.Tags.SimpleDutyTag%3B" />
            <_QuestBehaviorAliasLine Include="global using HuntBehavior = RBQuestBehaviors::ff14bot.NeoProfiles.Tags.HuntBehavior%3B" />
        </ItemGroup>
        <WriteLinesToFile File="$(_QuestBehaviorAliasesFile)" Lines="@(_QuestBehaviorAliasLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(_QuestBehaviorAliasesFile)" />
            <FileWrites Include="$(_QuestBehaviorAliasesFile)" />
        </ItemGroup>
    </Target>
</Project>
